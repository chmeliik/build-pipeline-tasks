{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    ".github/actions/install-tkn/action.yaml",
    ".github/resources/workspace-template.yaml",
    ".github/scripts/check_tekton_tasks.sh",
    ".github/scripts/test_tekton_tasks.sh",
    ".github/workflows/check-kustomize-build.yaml",
    ".github/workflows/check-ta.yaml",
    ".github/workflows/check-task-migration.yaml",
    ".github/workflows/checkton.yaml",
    ".github/workflows/run-task-tests.yaml",
    ".github/workflows/task-lint.yaml",
    ".github/workflows/update-shared-ci.yaml",
    ".github/workflows/versioning.yaml"
  ],
  "tekton": {
    "includePaths": [
      ".tekton/**",
      "task/**",
      "pipelines/**"
    ],
    "packageRules": [
      {
        "matchFileNames": [
          "task/**",
          "pipelines/**"
        ],
        "schedule": [
          "at any time"
        ]
      },
      {
        "matchFileNames": [
          "task/prefetch-dependencies/**",
          "task/prefetch-dependencies-oci-ta/**",
          "task/prefetch-dependencies-oci-ta-min/**"
        ],
        "matchPackageNames": [
          "quay.io/konflux-ci/hermeto"
        ],
        "enabled": false
      },
      {
        "groupName": "build pipeline tasks",
        "matchDepNames": [
          "quay.io/konflux-ci/tekton-catalog/task-apply-tags",
          "quay.io/konflux-ci/tekton-catalog/task-build-image-index",
          "quay.io/konflux-ci/tekton-catalog/task-build-image-index-min",
          "quay.io/konflux-ci/tekton-catalog/task-buildah",
          "quay.io/konflux-ci/tekton-catalog/task-buildah-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-buildah-oci-ta-min",
          "quay.io/konflux-ci/tekton-catalog/task-buildah-remote-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-git-clone",
          "quay.io/konflux-ci/tekton-catalog/task-git-clone-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-git-clone-oci-ta-min",
          "quay.io/konflux-ci/tekton-catalog/task-init",
          "quay.io/konflux-ci/tekton-catalog/task-push-dockerfile",
          "quay.io/konflux-ci/tekton-catalog/task-push-dockerfile-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-source-build",
          "quay.io/konflux-ci/tekton-catalog/task-source-build-oci-ta"
        ],
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "group": {
          "branchTopic": "{{{groupSlug}}}"
        }
      },
      {
        "groupName": "build-prefetch pipeline tasks",
        "matchDepNames": [
          "quay.io/konflux-ci/tekton-catalog/task-prefetch-dependencies",
          "quay.io/konflux-ci/tekton-catalog/task-prefetch-dependencies-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-prefetch-dependencies-oci-ta-min"
        ],
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "group": {
          "branchTopic": "{{{groupSlug}}}"
        }
      },
      {
        "groupName": "integration pipeline tasks",
        "matchDepNames": [
          "quay.io/konflux-ci/tekton-catalog/task-clair-scan",
          "quay.io/konflux-ci/tekton-catalog/task-clamav-scan",
          "quay.io/konflux-ci/tekton-catalog/task-clamav-scan-min",
          "quay.io/konflux-ci/tekton-catalog/task-deprecated-image-check",
          "quay.io/konflux-ci/tekton-catalog/task-tpa-scan"
        ],
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "group": {
          "branchTopic": "{{{groupSlug}}}"
        }
      },
      {
        "groupName": "preflight pipeline tasks",
        "matchDepNames": [
          "quay.io/konflux-ci/tekton-catalog/task-ecosystem-cert-preflight-checks"
        ],
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "group": {
          "branchTopic": "{{{groupSlug}}}"
        }
      },
      {
        "groupName": "sast pipeline tasks",
        "matchDepNames": [
          "quay.io/konflux-ci/tekton-catalog/task-sast-shell-check",
          "quay.io/konflux-ci/tekton-catalog/task-sast-shell-check-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-sast-shell-check-oci-ta-min",
          "quay.io/konflux-ci/tekton-catalog/task-sast-snyk-check",
          "quay.io/konflux-ci/tekton-catalog/task-sast-snyk-check-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-sast-unicode-check",
          "quay.io/konflux-ci/tekton-catalog/task-sast-unicode-check-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-sast-unicode-check-oci-ta-min"
        ],
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "group": {
          "branchTopic": "{{{groupSlug}}}"
        }
      },
      {
        "groupName": "vanguard pipeline tasks",
        "matchDepNames": [
          "quay.io/konflux-ci/tekton-catalog/task-rpms-signature-scan"
        ],
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "group": {
          "branchTopic": "{{{groupSlug}}}"
        }
      },
      {
        "groupName": "operator pipeline tasks",
        "matchDepNames": [
          "quay.io/konflux-ci/tekton-catalog/task-fbc-fips-check-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-fbc-inject-lifecycle-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-fbc-target-index-pruning-check",
          "quay.io/konflux-ci/tekton-catalog/task-run-opm-command-oci-ta",
          "quay.io/konflux-ci/tekton-catalog/task-validate-fbc"
        ],
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "group": {
          "branchTopic": "{{{groupSlug}}}"
        }
      }
    ]
  },
  "gomod": {
    "packageRules": [
      {
        "matchFileNames": [
          "task-generator/**"
        ],
        "groupName": "task-generator",
        "schedule": [
          "on sunday"
        ]
      }
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["task/**/recipe.yaml", "task/**/patch.yaml"],
      "matchStrings": [
        "image: (?:['\"])?(?<depName>[0-9a-z./-]+)(?::(?<currentValue>[0-9a-z.-]+))?@(?<currentDigest>sha256:[a-f0-9]{64})(?:['\"])?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["pipelines/**/patch.yaml"],
      "matchStrings": [
        "value: (?:['\"])?(?<depName>[0-9a-z./-]+)(?::(?<currentValue>[0-9a-z.-]+))?@(?<currentDigest>sha256:[a-f0-9]{64})(?:['\"])?"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "groupName": "build pipeline tasks",
      "matchDepNames": [
        "quay.io/konflux-ci/tekton-catalog/task-apply-tags",
        "quay.io/konflux-ci/tekton-catalog/task-build-image-index",
        "quay.io/konflux-ci/tekton-catalog/task-build-image-index-min",
        "quay.io/konflux-ci/tekton-catalog/task-buildah",
        "quay.io/konflux-ci/tekton-catalog/task-buildah-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-buildah-oci-ta-min",
        "quay.io/konflux-ci/tekton-catalog/task-buildah-remote-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-git-clone",
        "quay.io/konflux-ci/tekton-catalog/task-git-clone-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-git-clone-oci-ta-min",
        "quay.io/konflux-ci/tekton-catalog/task-init",
        "quay.io/konflux-ci/tekton-catalog/task-push-dockerfile",
        "quay.io/konflux-ci/tekton-catalog/task-push-dockerfile-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-source-build",
        "quay.io/konflux-ci/tekton-catalog/task-source-build-oci-ta"
      ]
    },
    {
      "groupName": "build-prefetch pipeline tasks",
      "matchDepNames": [
        "quay.io/konflux-ci/tekton-catalog/task-prefetch-dependencies",
        "quay.io/konflux-ci/tekton-catalog/task-prefetch-dependencies-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-prefetch-dependencies-oci-ta-min"
      ]
    },
    {
      "groupName": "integration pipeline tasks",
      "matchDepNames": [
        "quay.io/konflux-ci/tekton-catalog/task-clair-scan",
        "quay.io/konflux-ci/tekton-catalog/task-clamav-scan",
        "quay.io/konflux-ci/tekton-catalog/task-clamav-scan-min",
        "quay.io/konflux-ci/tekton-catalog/task-deprecated-image-check",
        "quay.io/konflux-ci/tekton-catalog/task-tpa-scan"
      ]
    },
    {
      "groupName": "preflight pipeline tasks",
      "matchDepNames": [
        "quay.io/konflux-ci/tekton-catalog/task-ecosystem-cert-preflight-checks"
      ]
    },
    {
      "groupName": "sast pipeline tasks",
      "matchDepNames": [
        "quay.io/konflux-ci/tekton-catalog/task-sast-shell-check",
        "quay.io/konflux-ci/tekton-catalog/task-sast-shell-check-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-sast-shell-check-oci-ta-min",
        "quay.io/konflux-ci/tekton-catalog/task-sast-snyk-check",
        "quay.io/konflux-ci/tekton-catalog/task-sast-snyk-check-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-sast-unicode-check",
        "quay.io/konflux-ci/tekton-catalog/task-sast-unicode-check-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-sast-unicode-check-oci-ta-min"
      ]
    },
    {
      "groupName": "vanguard pipeline tasks",
      "matchDepNames": [
        "quay.io/konflux-ci/tekton-catalog/task-rpms-signature-scan"
      ]
    },
    {
      "groupName": "operator pipeline tasks",
      "matchDepNames": [
        "quay.io/konflux-ci/tekton-catalog/task-fbc-fips-check-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-fbc-inject-lifecycle-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-fbc-target-index-pruning-check",
        "quay.io/konflux-ci/tekton-catalog/task-run-opm-command-oci-ta",
        "quay.io/konflux-ci/tekton-catalog/task-validate-fbc"
      ]
    }
  ]
}
