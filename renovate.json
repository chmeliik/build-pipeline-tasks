{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignorePaths": [
    ".github/actions/install-tkn/action.yaml",
    ".github/resources/workspace-template.yaml",
    ".github/scripts/check_tekton_tasks.sh",
    ".github/scripts/test_tekton_tasks.sh",
    ".github/workflows/check-kustomize-build.yaml",
    ".github/workflows/check-ta.yaml",
    ".github/workflows/check-task-migration.yaml",
    ".github/workflows/checkton.yaml",
    ".github/workflows/run-task-tests.yaml",
    ".github/workflows/task-lint.yaml",
    ".github/workflows/update-shared-ci.yaml",
    ".github/workflows/versioning.yaml"
  ],
  "tekton": {
    "includePaths": [
      ".tekton/**",
      "task/**",
      "pipelines/**"
    ],
    "packageRules": [
      {
        "matchFileNames": [
          "task/**",
          "pipelines/**"
        ],
        "schedule": [
          "at any time"
        ]
      },
      {
        "matchFileNames": [
          "task/prefetch-dependencies/**",
          "task/prefetch-dependencies-oci-ta/**",
          "task/prefetch-dependencies-oci-ta-min/**"
        ],
        "matchPackageNames": [
          "quay.io/konflux-ci/hermeto"
        ],
        "enabled": false
      },
      {
        "groupName": "pipeline bundle tasks",
        "matchFileNames": [
          "pipelines/**"
        ],
        "branchPrefix": "konflux/mintmaker/",
        "additionalBranchPrefix": "{{baseBranch}}/",
        "group": {
          "branchTopic": "{{{groupSlug}}}"
        }
      }
    ]
  },
  "gomod": {
    "packageRules": [
      {
        "matchFileNames": [
          "task-generator/**"
        ],
        "groupName": "task-generator",
        "schedule": [
          "monthly"
        ]
      },
      {
        "matchDepTypes": ["indirect"],
        "enabled": false
      }
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["task/**/recipe.yaml", "task/**/patch.yaml"],
      "matchStrings": [
        "image: (?:['\"])?(?<depName>[0-9a-z./-]+)(?::(?<currentValue>[0-9a-z.-]+))?@(?<currentDigest>sha256:[a-f0-9]{64})(?:['\"])?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "task/buildah-remote/buildah-remote.yaml",
        "task/buildah-remote-oci-ta/buildah-remote-oci-ta.yaml"
      ],
      "matchStrings": [
        "value: (?:['\"])?(?<depName>[0-9a-z./-]+)(?::(?<currentValue>[0-9a-z.-]+))?@(?<currentDigest>sha256:[a-f0-9]{64})(?:['\"])?"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
